# PostgreSQL: URL-encode special password characters; credentials stay on server.
DATABASE_URL=postgresql://edokumenty:CHANGE_ME@127.0.0.1:5432/edokumenty?sslmode=require
DATABASE_SCHEMA=edokumenty

# Copy to .env and fill in your existing private bucket configuration.
EDOCUMENTS_STORAGE=s3
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, for temporary credentials:
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
S3_PREFIX=edokumenty

# Sending files and collecting recipient approvals. Use the application's public
# address reachable by recipients, without a path or a trailing slash.
EDOCUMENTS_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587), ssl (usually 465), none (local relay)
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Fernet key for personal mail passwords; keep the same key across servers.
# Without this variable, the application creates data/mail-settings.key.
EDOCUMENTS_MAIL_SETTINGS_KEY=

# SMSAPI: personal approval links sent by SMS. Token and sender stay on server.
SMSAPI_TOKEN=
# Optional approved sender name (max 11 characters); blank uses provider default.
SMSAPI_SENDER=

# OpenAI generation for new documents and templates. Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
